{
  "name": "sonvn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "node --experimental-strip-types scripts/run-coverage-gates.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:migrate": "cross-env DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/flof_test prisma migrate deploy",
    "test:db:fixtures": "cross-env TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/flof_test tsx scripts/test-db-fixtures.ts",
    "test:integration": "cross-env TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/flof_test tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:load": "cross-env TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/flof_test playwright test e2e/load-gate.spec.ts --project=chromium",
    "openapi:sync": "node --experimental-strip-types scripts/sync-openapi-inventory.ts",
    "test:openapi": "redocly lint docs/openapi.yaml && node --experimental-strip-types scripts/validate-openapi-coverage.ts",
    "test:e2e": "cross-env TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/flof_test playwright test",
    "test:env": "node --experimental-strip-types --test tests/release-environment.test.ts",
    "test:lighthouse": "node --experimental-strip-types scripts/run-lighthouse-gate.ts",
    "test:bundle": "node --experimental-strip-types scripts/check-bundle-budgets.ts",
    "check:release-env": "node --experimental-strip-types scripts/check-release-environment.ts",
    "check:deployment-smoke": "node --experimental-strip-types scripts/check-deployment-smoke.ts",
    "check:production-load": "node --experimental-strip-types scripts/run-production-load-profile.ts",
    "check:provider:upstash": "cross-env PROVIDER_CHECK=upstash tsx scripts/verify-provider-readiness.ts",
    "check:provider:resend": "cross-env PROVIDER_CHECK=resend tsx scripts/verify-provider-readiness.ts",
    "check:provider:cloudinary": "cross-env PROVIDER_CHECK=cloudinary tsx scripts/verify-provider-readiness.ts",
    "check:account": "node --experimental-strip-types scripts/diagnose-login.ts",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast-tokens.ts",
    "check": "npm run lint && npm run typecheck && npm run check:contrast && npm test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.60.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.1",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.4",
    "react": "19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.53.0",
    "resend": "^4.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vnpay": "^2.5.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@redocly/cli": "^2.40.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.23",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
  }
}
